# Backend environment — copy to backend/.env
# Every value is optional in development; production validates on startup.

# ---- LLM providers (LLM_PROVIDER=auto uses the first available) ----
LLM_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Databases ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Runtime ----
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
