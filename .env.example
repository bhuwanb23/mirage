# ============================================================
# Mirage — environment template
# Copy to the right place:
#   backend/.env   (backend keys)
#   bot/.env       (bot keys)
# Frontend uses frontend/.env.local
# ============================================================

# ---------- Backend ----------
# LLM providers (any subset — LLM_PROVIDER=auto picks the first available)
LLM_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Databases
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---------- Bot ----------
TELEGRAM_BOT_TOKEN=
BACKEND_URL=http://localhost:8000

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
