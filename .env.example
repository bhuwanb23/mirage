# ============================================================
# Mirage — environment template
# Copy to the right place:
#   backend/.env   (backend keys)
#   bot/.env       (bot keys)
# Frontend uses frontend/.env.local
# ============================================================

# ---------- Backend ----------
# LLM providers (any subset — LLM_PROVIDER=auto picks the first available)
LLM_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Databases
SUPABASE_URL=
# Either name works (publishable is the newer Supabase dashboard label)
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---------- Bot ----------
TELEGRAM_BOT_TOKEN=
BACKEND_URL=http://localhost:8000

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Demo mode (plan §7.3): fixed user id so the dashboard shows the seeded
# Priya Sharma profile + drill history. Leave unset for normal use.
# Must match DEMO_USER_ID in backend/app/services/demo_seed.py.
# NEXT_PUBLIC_DEMO_USER_ID=7f3a9c1e-5d2b-4f8a-9e6c-1b8d4a7f2c9e
